# Contact form - Discord notification. Required: without it, submissions are
# accepted by the API but only logged, never delivered.
FORM_SUBMISSION_WEBHOOK_URL=

# Contact form - confirmation email to the person who submitted.
# Optional: unset just skips the email, the lead still reaches Discord.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
CONTACT_FROM_EMAIL="Stash Labs <team@stashlabs.com.au>"

# Analytics (optional)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=

# --- /admin ops dashboard ---------------------------------------------------

# Every figure on /admin is read from Stripe, server-side, at render. A
# RESTRICTED read-only key is enough and is what belongs here.
# Without it the dashboard loads and shows empty states rather than failing.
STRIPE_SECRET_KEY=

# The single shared login, compared as plain text.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Signs the session cookie. Optional: with it unset the key is derived from the
# two values above, which is only as strong as the password. Set it in
# production (openssl rand -hex 32). Changing it signs everyone out.
ADMIN_SESSION_SECRET=

# Runway, the two figures Stripe cannot know. Both optional - with either
# unset, Runway renders an empty state instead of a made-up number.
# Whole dollars, not cents.
